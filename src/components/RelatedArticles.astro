---
import type { CollectionEntry } from 'astro:content';
import { getCoverImage } from '../utils/cover';
import { relatedFor } from '../utils/linkGraph';

interface Props {
  current: CollectionEntry<'articles'>;
  all: CollectionEntry<'articles'>[];
  count?: number;
}

const { current, all, count = 3 } = Astro.props;

// Dobór liczy utils/linkGraph.ts dla całej kolekcji naraz — tylko globalnie da się
// pilnować wzajemności linków i tego, żeby żaden artykuł nie został bez przychodzących.
const related = relatedFor(current, all).slice(0, count);

const covers = await Promise.all(
  related.map((a) => getCoverImage(a.data.cover, a.data.tags, a.data.coverQuery, a.id))
);
---

{related.length > 0 && (
  <div class="related-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-bottom:32px;">
    {related.map((article, i) => (
      <div class="card" style="overflow:hidden; position:relative;">
        <img
          src={covers[i]}
          alt={article.data.title}
          style="width:100%; height:160px; object-fit:cover; display:block;"
          width="800"

          height="450"

          decoding="async"

          loading="lazy"
        />
        <div style="padding:16px;">
          <h3 class="h-title" style="font-size:14px; margin:0 0 6px;">
            <a href={`/artykuly/${article.id}`} class="stretched-link">{article.data.title}</a>
          </h3>
          <p class="t-body" style="font-size:13px; color:var(--ink-soft); margin:0;">{article.data.description}</p>
        </div>
      </div>
    ))}
  </div>
)}
